{
  // Cloudflare Workers deploy config (OpenNext).  Docs: https://opennext.js.org/cloudflare
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "platform-withdrawals",
  "main": ".open-next/worker.js",
  // nodejs_compat is REQUIRED — pg + react-pdf use Node APIs (net/tls, buffer, streams).
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Hyperdrive proxies/pools the Postgres connection — Workers can't open raw TCP
  // to Supabase. Create the config with `wrangler hyperdrive create` and paste its
  // id below (replace REPLACE_WITH_HYPERDRIVE_ID).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "1b6c680aa6e84d1ea404483de7ef48c2",
      // Dummy — only used for LOCAL Hyperdrive emulation (we don't use wrangler dev;
      // local dev uses PGlite). Production uses the real config via `id`. Not a secret.
      "localConnectionString": "postgresql://user:pass@localhost:5432/postgres"
    }
  ],
  "observability": {
    "enabled": true
  }
  // Secrets (DATABASE_URL, ADMIN_USERNAME, ADMIN_PASSWORD, optional DATABASE_CA_CERT)
  // are set via `wrangler secret put ...` or the Cloudflare dashboard — NOT here.
}
