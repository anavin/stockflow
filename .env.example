# ============================================================================
# 3 สภาพแวดล้อม (tiers) — เลือกอย่างใดอย่างหนึ่งต่อเครื่อง/ต่อ deployment
# ============================================================================

# ---- 1) LOCAL SANDBOX (ค่าเริ่มต้น — ใช้ทดลอง ไม่กระทบระบบจริง) --------------
# ไม่ต้องตั้ง DATABASE_URL → ระบบใช้ PGlite ฝังในเครื่อง (./.pgdata) แยกขาดจาก prod
# `npm run dev` แล้ว login ด้วยแอดมินด้านล่าง · รีเซ็ตข้อมูลทดลอง: `npm run reset`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# ---- 2) STAGING (ทดสอบเหมือนจริง ก่อนขึ้น prod) -----------------------------
# ใช้ Supabase คนละ project กับ prod → ตั้งบน Vercel deployment "staging" เท่านั้น
# (อย่าเอามาใส่ .env.local ของเครื่อง dev — จะทำให้ npm run dev เขียน DB จริง)
# NEXT_PUBLIC_APP_ENV=staging
# DATABASE_URL=postgres://postgres.<staging-ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---- 3) PRODUCTION (ระบบจริง — ตั้งบน Vercel prod เท่านั้น ห้ามใส่ในเครื่อง dev) ----
# DATABASE_URL=postgres://postgres.<prod-ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# SUPABASE_SERVICE_ROLE_KEY=<service role key>   # server-only, ห้ามหลุดฝั่ง client

# ---- CTW push (ถ้าใช้) -----------------------------------------------------
# CTW_WEBHOOK_URL=
# CTW_API_KEY=

# ============================================================================
# 🛡️ guardrail: ถ้ารัน `npm run dev` โดยมี DATABASE_URL ที่ไม่ได้ระบุ tier
#    ระบบจะ "หยุด" ทันที (กันเผลอต่อ prod) — จะต่อ prod จริงต้องตั้ง ALLOW_PROD_DB=1
# ============================================================================
